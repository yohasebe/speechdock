<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="SpeechDock Terminology">
    <suite name="SpeechDock Suite" code="SDck" description="Commands for controlling SpeechDock text-to-speech, transcription, and translation.">

        <!-- Classes -->
        <class name="application" code="capp" description="The SpeechDock application.">
            <cocoa class="NSApplication"/>
            <property name="tts provider" code="TTSp" type="text" access="rw" description="The current TTS provider (macOS, OpenAI, Gemini, ElevenLabs, Grok).">
                <cocoa key="scriptTTSProvider"/>
            </property>
            <property name="tts voice" code="TTSv" type="text" access="rw" description="The current TTS voice name.">
                <cocoa key="scriptTTSVoice"/>
            </property>
            <property name="tts speed" code="TTSs" type="real" access="rw" description="The TTS playback speed (0.25 to 4.0, default 1.0).">
                <cocoa key="scriptTTSSpeed"/>
            </property>
            <property name="stt provider" code="STTp" type="text" access="rw" description="The current STT provider (macOS, OpenAI, Gemini, ElevenLabs, Grok).">
                <cocoa key="scriptSTTProvider"/>
            </property>
            <property name="translation provider" code="TrPv" type="text" access="rw" description="The current translation provider (macOS, OpenAI, Gemini, Grok).">
                <cocoa key="scriptTranslationProvider"/>
            </property>
            <property name="is speaking" code="IsSp" type="boolean" access="r" description="Whether TTS is currently speaking or paused.">
                <cocoa key="scriptIsSpeaking"/>
            </property>
            <property name="is recording" code="IsRc" type="boolean" access="r" description="Whether STT is currently recording.">
                <cocoa key="scriptIsRecording"/>
            </property>
            <property name="quick transcription visible" code="QTVs" type="boolean" access="rw" description="Whether the quick transcription floating button is visible.">
                <cocoa key="scriptShowQuickTranscription"/>
            </property>
        </class>

        <!-- TTS Commands -->
        <command name="speak text" code="SDckSpTx" description="Speak the given text using the current TTS provider and voice.">
            <cocoa class="SpeechDock.SpeakTextCommand"/>
            <direct-parameter type="text" description="The text to speak."/>
        </command>

        <command name="stop speaking" code="SDckStSp" description="Stop the current TTS playback.">
            <cocoa class="SpeechDock.StopSpeakingCommand"/>
        </command>

        <command name="pause speaking" code="SDckPaSp" description="Pause the current TTS playback.">
            <cocoa class="SpeechDock.PauseSpeakingCommand"/>
        </command>

        <command name="resume speaking" code="SDckReSp" description="Resume paused TTS playback.">
            <cocoa class="SpeechDock.ResumeSpeakingCommand"/>
        </command>

        <command name="save audio" code="SDckSvAu" description="Synthesize text to an audio file using the current TTS provider. The file extension sets the format: .m4a, .wav, .aiff or .caf with any provider, .mp3 with providers that produce MP3.">
            <cocoa class="SpeechDock.SaveAudioCommand"/>
            <direct-parameter type="text" description="The text to synthesize."/>
            <parameter name="to file" code="SvPa" type="text" description="The file path to save the audio to.">
                <cocoa key="toFile"/>
            </parameter>
            <result type="text" description="The path of the saved audio file."/>
        </command>

        <!-- Translation Command -->
        <command name="translate" code="SDckTrTx" description="Translate text to the specified language using the current translation provider.">
            <cocoa class="SpeechDock.TranslateCommand"/>
            <direct-parameter type="text" description="The text to translate."/>
            <parameter name="to" code="TrTo" type="text" description="The target language name (e.g. Japanese, French, German).">
                <cocoa key="toLanguage"/>
            </parameter>
            <result type="text" description="The translated text."/>
        </command>

        <!-- Transcription Command -->
        <command name="transcribe file" code="SDckTrFi" description="Transcribe an audio file using the current STT provider.">
            <cocoa class="SpeechDock.TranscribeFileCommand"/>
            <direct-parameter type="text" description="The POSIX path of the audio file to transcribe."/>
            <result type="text" description="The transcribed text."/>
        </command>

        <!-- Clipboard Commands -->
        <command name="copy to clipboard" code="SDckCpCl" description="Copy the given text to the system clipboard.">
            <cocoa class="SpeechDock.CopyToClipboardCommand"/>
            <direct-parameter type="text" description="The text to copy."/>
        </command>

        <command name="paste text" code="SDckPsTx" description="Copy text and request a paste into the frontmost application. Returns inserted only when the result can be verified; otherwise returns copied to clipboard.">
            <cocoa class="SpeechDock.PasteTextCommand"/>
            <result type="text" description="inserted or copied to clipboard"/>
            <direct-parameter type="text" description="The text to paste."/>
        </command>

        <!-- UI Commands -->
        <command name="show shortcuts" code="SDckShSc" description="Display the keyboard shortcuts cheat sheet panel.">
            <cocoa class="SpeechDock.ShowShortcutsCommand"/>
        </command>

        <!-- Quick Transcription Commands -->
        <command name="show quick transcription" code="SDckShQT" description="Show the floating mic button without starting recording.">
            <cocoa class="SpeechDock.ShowQuickTranscriptionCommand"/>
        </command>

        <command name="start quick transcription" code="SDckStQT" description="Start quick transcription using the floating mic button. Transcribed text is pasted when stopped.">
            <cocoa class="SpeechDock.StartQuickTranscriptionCommand"/>
        </command>

        <command name="stop quick transcription" code="SDckSpQT" description="Stop quick transcription, wait for final recognition, and return the latest transcribed text.">
            <cocoa class="SpeechDock.StopQuickTranscriptionCommand"/>
            <result type="text" description="The latest transcribed text, or an empty string if nothing was transcribed."/>
        </command>

        <command name="toggle quick transcription" code="SDckTgQT" description="Toggle quick transcription recording on/off.">
            <cocoa class="SpeechDock.ToggleQuickTranscriptionCommand"/>
        </command>

        <!-- STT Panel Commands -->
        <command name="show stt panel" code="SDckShST" description="Show the STT (speech-to-text) panel. Opening it stops TTS and, if auto-start is enabled, starts recording. An already open panel keeps its text and recording state. In floating style, drag the top handle to move the panel.">
            <cocoa class="SpeechDock.ShowSTTPanelCommand"/>
        </command>

        <command name="toggle stt panel" code="SDckTgST" description="Close the visible STT panel and stop recording, or open it without recording. Never starts recording.">
            <cocoa class="SpeechDock.ToggleSTTPanelCommand"/>
        </command>

        <!-- TTS Panel Commands -->
        <command name="show tts panel" code="SDckShTT" description="Show the TTS (text-to-speech) panel for manual text input without speaking. Opening it stops STT; showing an already open panel preserves its text. In floating style, drag the top handle to move the panel.">
            <cocoa class="SpeechDock.ShowTTSPanelCommand"/>
        </command>

        <command name="toggle tts panel" code="SDckTgTT" description="Close the visible TTS panel and stop playback, or open it without speaking. Never starts speaking.">
            <cocoa class="SpeechDock.ToggleTTSPanelCommand"/>
        </command>

        <!-- Subtitle Commands -->
        <command name="show subtitle" code="SDckShSu" description="Enable subtitle mode and start recording if stopped, including when subtitle mode is already enabled. Drag the top handle to move the overlay.">
            <cocoa class="SpeechDock.ShowSubtitleCommand"/>
        </command>

        <command name="toggle subtitle" code="SDckTgSu" description="Toggle subtitle mode on/off.">
            <cocoa class="SpeechDock.ToggleSubtitleCommand"/>
        </command>

        <command name="hide stt panel" code="SDckHdST" description="Stop recording and file transcription and close the STT panel if open. Repeated calls have no effect.">
            <cocoa class="SpeechDock.HideSTTPanelCommand"/>
        </command>
        <command name="hide tts panel" code="SDckHdTT" description="Stop speech and audio generation and close the TTS panel if open. Repeated calls have no effect.">
            <cocoa class="SpeechDock.HideTTSPanelCommand"/>
        </command>
        <command name="hide subtitle" code="SDckHdSu" description="Stop subtitle recording and close the subtitle overlay if enabled. Repeated calls have no effect.">
            <cocoa class="SpeechDock.HideSubtitleCommand"/>
        </command>

        <!-- OCR Command -->
        <command name="start ocr" code="SDckStOC" description="Start OCR region selection. Selected text is sent to the TTS panel.">
            <cocoa class="SpeechDock.StartOCRCommand"/>
        </command>

    </suite>
</dictionary>
